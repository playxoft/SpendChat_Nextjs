# SpendChat environment variables.
# Maintainers inject these from Doppler; this file documents what is required.
# For local-without-Doppler dev, copy to `.env.local`, fill in values, and use
# the `*:local` scripts (`pnpm dev:local`, `pnpm db:migrate:local`, …).
#
# Note: those scripts `source` this file as a shell script, so a literal `$` in
# a value must be escaped (`\$`) or single-quoted to avoid being expanded.

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string from the Neon console (sslmode=require).
NEON_POSTGRES_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Firebase Authentication -----------------------------------------------
# The whole Firebase web config as ONE JSON value (public by design — it's the
# client SDK config, inlined into the bundle at build time). From the Firebase
# console: Project settings -> General -> Your apps -> Web. The server verifies
# ID tokens against the `projectId` inside it. Keep it on a single line.
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"AIzaSy...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","storageBucket":"your-project.firebasestorage.app","messagingSenderId":"1234567890","appId":"1:1234567890:web:abc123"}'

# --- File storage: Cloudflare R2 (receipts + the document vault) ------------
# Required for BOTH transaction attachments and the /app/files vault. With any
# of these unset the app still runs, but every upload and download answers 503
# ("File storage isn't configured") — the feature disables itself rather than
# half-working. All five are needed together.
#
# From the Cloudflare dashboard: R2 -> Overview (account id, and "Create bucket"),
# then R2 -> Manage API tokens -> Create API token, scoped to *that* bucket with
# "Object Read & Write". The token screen shows the access key id and secret once.
#
# Requests are signed with SigV4 (aws4fetch) against the S3-compatible endpoint,
# and downloads go out as short-lived presigned URLs — so the bucket itself must
# stay PRIVATE. Do not enable public access or attach an r2.dev domain.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# S3 API base for the bucket, no trailing slash. Normally
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=""

# --- Email (ZeptoMail) ------------------------------------------------------
# Optional, and only used to send workspace member invites. Leave unset and the
# invite still records a `workspace_invites` row (so it converts when the
# invitee signs up) — the recipient just never gets an email about it.
#
# From ZeptoMail: Mail Agents -> your agent -> "Send Mail API". The token is the
# whole header value INCLUDING the "Zoho-enczapikey " prefix.
ZEPTOMAIL_TOKEN=""
# Regional API endpoint, e.g. https://api.zeptomail.com/v1.1/email (.eu / .in
# for those data centres).
ZEPTOMAIL_API_URL=""
# Must be an address on a domain verified in ZeptoMail, or every send is rejected.
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="SpendChat"

# --- Site ------------------------------------------------------------------
# Canonical public URL, used for SEO/canonical/OpenGraph and sitemap.
NEXT_PUBLIC_SITE_URL="https://spendchat.app"
# Optional. Google Search Console ownership proof, from the "HTML tag" method:
# copy only the content value of <meta name="google-site-verification" ...>.
# Inlined at build time, so set it in Doppler and rebuild. Leave unset to omit
# the tag entirely. Verifying by DNS TXT record instead needs no code change.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Analytics (marketing pages only) ---------------------------------------
# Optional. Both are public, client-side ids (inlined at build time) — leave
# either unset to skip loading that script entirely. Nothing loads until the
# visitor accepts the cookie consent banner (src/lib/consent.ts); no analytics
# runs on the authenticated app, only the (marketing) route group.
# GA4 Measurement ID, from the Google Analytics admin (Data Streams -> your
# stream). Format "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Microsoft Clarity Project ID, from the Clarity dashboard -> Settings ->
# Setup -> Install tracking code (the id at the end of the tag URL).
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# --- Logging (BetterStack Telemetry) ---------------------------------------
# Optional. When both are set, structured logs are shipped to BetterStack in
# addition to the console. Omit them and the app just logs to the console.
# From BetterStack: Telemetry -> Sources -> your source -> "Connect / HTTP".
BETTERSTACK_SOURCE_TOKEN="your-source-ingest-token"
BETTERSTACK_INGESTING_HOST="sXXXXXXX.region.betterstackdata.com"
# Minimum level to emit: debug | info | warn | error | silent. Default: info.
# (DB SELECT reads log at debug, so leave at info in prod to avoid noise.)
LOG_LEVEL="info"
# Tags every shipped log with `environment`, so one BetterStack source can hold
# production and beta and still be filtered apart. NODE_ENV is "production" on
# both deployments and cannot do this. Set on the deployed Workers by
# wrangler.toml ([env.*.vars]); set it here only if you want local logs labelled.
APP_ENV="development"

# --- AI transaction input (bring your own model) ---------------------------
# Optional. Powers the composer's "AI" mode: free text like
# "200 fruits, 100 veg, 1000 electricity, got 5000 salary" is parsed into
# transactions the user reviews before saving. Leave the vars below unset to
# keep AI mode disabled (it still shows, but returns a friendly "not available").
#
# The model lives ENTIRELY here — nothing is hard-coded in the app. Two vars:
#
#   AI_PARSE_MODEL          A JSON registry of models, keyed by any name you pick.
#                           Each entry: {"model_id","api_key","provider"?,"base_url"?}.
#                           The key lives inside the entry — no separate provider keys.
#   AI_PARSE_MODEL_CURRENT  The name of the entry to use right now.
#
# Entry fields:
#   model_id   the provider's model id (required)
#   api_key    the key to call it with (required)
#   provider   "gemini" | "openai" | "anthropic". Optional — inferred from
#              model_id (gemini* / claude* / gpt*|o*). Set it for anything the
#              inference can't place (DeepSeek, Llama, Qwen … all use "openai").
#   base_url   optional — override the API base to point "openai" at an
#              OpenAI-compatible host.
#
# Not supported: OpenAI's reasoning models (o1, o3, …). They reject the
# `temperature` and `max_tokens` the adapter sends and want a `developer` role
# instead of `system`, so they fail as a generic upstream error. Use a standard
# chat model — the task is extraction, not reasoning.
#
# In deployed workers these are per-worker secrets and are NOT set by a deploy —
# push them with `wrangler secret put` for each env (see wrangler.toml). Until
# then AI mode answers "not available".
#
# Example (put the real values in Doppler, not here):
#   AI_PARSE_MODEL='{"primary":{"model_id":"<model-id>","api_key":"<key>"},"alt":{"model_id":"<model-id>","api_key":"<key>","provider":"openai","base_url":"https://<openai-compatible-host>"}}'
#   AI_PARSE_MODEL_CURRENT='primary'
AI_PARSE_MODEL=""
AI_PARSE_MODEL_CURRENT=""

# --- Voice entry / speech to text (bring your own model) -------------------
# Optional. Powers the mic in the composer's "AI" mode: hold it (or M), speak,
# and the recording is transcribed into the note you then send. Leave unset to
# keep the mic disabled (it shows, but answers "not available").
#
# Same registry format as AI_PARSE_MODEL above — a JSON object of named entries,
# plus the name of the active one. It is a SEPARATE pair on purpose: parsing runs
# on any chat model, transcription needs one that accepts audio, and there is
# deliberately no fallback from one to the other.
#
#   AI_TRANSCRIBE_MODEL          the registry
#   AI_TRANSCRIBE_MODEL_CURRENT  the active entry's name
#
# Providers that work here:
#   gemini   Sends the audio inline with a text instruction, so it can be told
#            about SEVERAL languages at once — which is what makes the
#            multi-select in Settings → Voice meaningful for code-mixed speech
#            (e.g. Tamil + Telugu + English in one sentence). Recommended.
#   openai   The multipart /audio/transcriptions shape — also covers Groq and any
#            OpenAI-compatible Whisper host via base_url. Whisper takes a single
#            language code (which we don't send, since pinning one transliterates
#            the rest), so the language list degrades to a vocabulary hint.
#   anthropic  NOT usable — Claude has no speech-to-text model. An entry pointing
#            there is treated as a misconfiguration.
#
# `provider` is inferred from model_id (gemini* / gpt* / whisper*); set it
# explicitly for anything else.
#
# MEASURE LATENCY BEFORE PICKING A MODEL — the per-token price is not the whole
# story. Holding a mic and waiting is the one place in this app where a slow model
# is unusable rather than merely annoying, and the spread between Gemini models on
# the same key is large and not predictable from the pricing table. Measured here
# on a 4s clip (2026-07-29): 3.1-flash-lite 2.0s, 3.6-flash 3.4s,
# 3-flash-preview 3.6s, and **3.5-flash-lite 32s** — despite being the cheapest
# on paper, it was ~10x slower than everything else and timed out in the app. Send
# one throwaway request to a candidate and time it before committing.
#
# Examples (put the real values in Doppler, not here):
#   # Gemini — fastest measured, and the same model can serve AI_PARSE_MODEL
#   AI_TRANSCRIBE_MODEL='{"primary":{"model_id":"gemini-3.1-flash-lite","api_key":"<key>"}}'
#   # Groq Whisper — cheapest and fastest, single-language
#   AI_TRANSCRIBE_MODEL='{"groq":{"model_id":"whisper-large-v3-turbo","api_key":"<key>","base_url":"https://api.groq.com/openai/v1"}}'
#   AI_TRANSCRIBE_MODEL_CURRENT='primary'
#
# Note: Gemini 3.x rejects `thinkingConfig.thinkingBudget` with 400 INVALID_ARGUMENT
# (it was replaced by `thinkingLevel`), which is why the transcribe adapter sends no
# thinking config at all — see `transcribeGemini` in src/lib/ai-provider.ts.
AI_TRANSCRIBE_MODEL=""
AI_TRANSCRIBE_MODEL_CURRENT=""
