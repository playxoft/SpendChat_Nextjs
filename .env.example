# MoneyTracker environment variables.
# Secrets are managed by Doppler — this file documents what is required.
# For local-without-Doppler dev, copy to `.env.local` and fill in values.

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string from the Neon console (sslmode=require).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Neon Auth (Stack Auth) ------------------------------------------------
# From Neon console -> Auth (or Stack Auth dashboard).
NEXT_PUBLIC_STACK_PROJECT_ID=""
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""

# --- Site ------------------------------------------------------------------
# Canonical public URL, used for SEO/canonical/OpenGraph and sitemap.
NEXT_PUBLIC_SITE_URL="https://moneytracker.playxoft.com"
