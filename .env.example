# SpendChat environment variables.
# Secrets are managed by Doppler — this file documents what is required.
# For local-without-Doppler dev, copy to `.env.local` and fill in values.

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string from the Neon console (sslmode=require).
NEON_POSTGRES_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Firebase Authentication -----------------------------------------------
# The whole Firebase web config as ONE JSON value (public by design — it's the
# client SDK config, inlined into the bundle at build time). From the Firebase
# console: Project settings -> General -> Your apps -> Web. The server verifies
# ID tokens against the `projectId` inside it. Keep it on a single line.
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"AIzaSy...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","storageBucket":"your-project.firebasestorage.app","messagingSenderId":"1234567890","appId":"1:1234567890:web:abc123"}'

# --- Firebase Admin (one-time migration script only; NOT used at runtime) ---
# Service-account JSON from Project settings -> Service accounts. Consumed only
# by scripts/migrate-to-firebase.mjs (firebase-admin). Never commit it.
GOOGLE_APPLICATION_CREDENTIALS="./.firebase-service-account.json"

# --- Site ------------------------------------------------------------------
# Canonical public URL, used for SEO/canonical/OpenGraph and sitemap.
NEXT_PUBLIC_SITE_URL="https://spendchat.app"
# Optional. Google Search Console ownership proof, from the "HTML tag" method:
# copy only the content value of <meta name="google-site-verification" ...>.
# Inlined at build time, so set it in Doppler and rebuild. Leave unset to omit
# the tag entirely. Verifying by DNS TXT record instead needs no code change.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Analytics (marketing pages only) ---------------------------------------
# Optional. Both are public, client-side ids (inlined at build time) — leave
# either unset to skip loading that script entirely. Nothing loads until the
# visitor accepts the cookie consent banner (src/lib/consent.ts); no analytics
# runs on the authenticated app, only the (marketing) route group.
# GA4 Measurement ID, from the Google Analytics admin (Data Streams -> your
# stream). Format "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Microsoft Clarity Project ID, from the Clarity dashboard -> Settings ->
# Setup -> Install tracking code (the id at the end of the tag URL).
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# --- Logging (BetterStack Telemetry) ---------------------------------------
# Optional. When both are set, structured logs are shipped to BetterStack in
# addition to the console. Omit them and the app just logs to the console.
# From BetterStack: Telemetry -> Sources -> your source -> "Connect / HTTP".
BETTERSTACK_SOURCE_TOKEN="your-source-ingest-token"
BETTERSTACK_INGESTING_HOST="sXXXXXXX.region.betterstackdata.com"
# Minimum level to emit: debug | info | warn | error | silent. Default: info.
# (DB SELECT reads log at debug, so leave at info in prod to avoid noise.)
LOG_LEVEL="info"

# --- AI transaction input (bring your own model) ---------------------------
# Optional. Powers the composer's "AI" mode: free text like
# "200 fruits, 100 veg, 1000 electricity, got 5000 salary" is parsed into
# transactions the user reviews before saving. Leave the vars below unset to
# keep AI mode disabled (it still shows, but returns a friendly "not available").
#
# The model lives ENTIRELY here — nothing is hard-coded in the app. Two vars:
#
#   AI_PARSE_MODEL          A JSON registry of models, keyed by any name you pick.
#                           Each entry: {"model_id","api_key","provider"?,"base_url"?}.
#                           The key lives inside the entry — no separate provider keys.
#   AI_PARSE_MODEL_CURRENT  The name of the entry to use right now.
#
# Entry fields:
#   model_id   the provider's model id (required)
#   api_key    the key to call it with (required)
#   provider   "gemini" | "openai" | "anthropic". Optional — inferred from
#              model_id (gemini* / claude* / gpt*|o*). Set it for anything the
#              inference can't place (DeepSeek, Llama, Qwen … all use "openai").
#   base_url   optional — override the API base to point "openai" at an
#              OpenAI-compatible host.
#
# Example (put the real values in Doppler, not here):
#   AI_PARSE_MODEL='{"primary":{"model_id":"<model-id>","api_key":"<key>"},"alt":{"model_id":"<model-id>","api_key":"<key>","provider":"openai","base_url":"https://<openai-compatible-host>"}}'
#   AI_PARSE_MODEL_CURRENT='primary'
AI_PARSE_MODEL=""
AI_PARSE_MODEL_CURRENT=""
