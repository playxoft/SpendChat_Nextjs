{
  "name": "spendchat",
  "version": "0.4.0",
  "private": true,
  "description": "A minimal, chat-style money tracker — add, view, filter, download, and print your income and expenses.",
  "license": "AGPL-3.0-only",
  "author": "Playxoft",
  "homepage": "https://spendchat.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playxoft/SpendChat_Nextjs.git"
  },
  "bugs": {
    "url": "https://github.com/playxoft/SpendChat_Nextjs/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "doppler run -- sh -c 'CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL next dev -p 3010'",
    "dev:local": "sh -c 'set -a; . ./.env.local; set +a; CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL next dev -p 3010'",
    "build": "doppler run -- next build",
    "build:local": "sh -c 'set -a; . ./.env.local; set +a; next build'",
    "start": "doppler run -- next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "preview": "doppler run -- opennextjs-cloudflare build --env production && doppler run -- sh -c 'CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL opennextjs-cloudflare preview --env production'",
    "build:worker": "doppler run -- opennextjs-cloudflare build",
    "deploy:dev": "doppler run --config dev -- opennextjs-cloudflare build --env beta && doppler run --config dev -- sh -c 'CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL opennextjs-cloudflare deploy --env beta'",
    "deploy:prod": "doppler run --config prd -- opennextjs-cloudflare build --env production && doppler run --config prd -- sh -c 'CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$NEON_POSTGRES_DATABASE_URL opennextjs-cloudflare deploy --env production'",
    "cf-typegen": "wrangler types --env production --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "doppler run --config dev -- drizzle-kit migrate",
    "db:migrate:prod": "doppler run --config prd -- drizzle-kit migrate",
    "db:migrate:local": "sh -c 'set -a; . ./.env.local; set +a; drizzle-kit migrate'",
    "db:studio:local": "sh -c 'set -a; . ./.env.local; set +a; drizzle-kit studio'",
    "db:push:dev": "doppler run --config dev -- drizzle-kit push",
    "db:push:prod": "doppler run --config prd -- drizzle-kit push",
    "db:studio:dev": "doppler run --config dev -- drizzle-kit studio",
    "db:studio:prod": "doppler run --config prd -- drizzle-kit studio",
    "kill-port": "lsof -ti:3010 | xargs kill -9"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "^16.2.9",
    "@opennextjs/cloudflare": "^1.19.11",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.15.0",
    "frimousse": "^0.3.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "read-excel-file": "^9.3.4",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "firebase-admin": "^14.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "^4.101.0"
  }
}
