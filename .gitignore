# ---- dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- next.js ----
/.next/
/out/
/build
next-env.d.ts

# ---- testing / coverage ----
/coverage

# ---- env & secrets (managed by Doppler — NEVER commit) ----
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# A Firebase Admin service-account key. The script that used to read it is gone,
# but the rule stays: it guards a private key with full project access, ignore
# rules for secrets cost nothing, and this one has to outlive whatever needed it.
.firebase-service-account.json

# ---- cloudflare / opennext / wrangler ----
/.open-next/
/.wrangler/
wrangler.*.local
cloudflare-env.d.ts

# ---- typescript ----
*.tsbuildinfo

# ---- logs / debug ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- editors / IDE ----
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---- OS ----
.DS_Store
Thumbs.db
*.pem

# ---- misc ----
.vercel

# ---- local-only, never committed (review reports, scratch notes, etc.) ----
_developer/local-only/

# /design-sync (Claude Design system sync)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/ds-entry.ts
# The claude.ai/design project this repo syncs to. Deliberately untracked: it
# names one maintainer's design project, which shouldn't ship with the source.
.design-sync/config.local.json
/dist
